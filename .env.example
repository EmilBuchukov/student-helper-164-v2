APP_NAME="164 ГПИЕ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Sofia

APP_LOCALE=bg
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bg_BG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. With Sail keep DB_HOST=pgsql; for native WSL set DB_HOST=127.0.0.1.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=school164
DB_USERNAME=sail
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sail: Mailpit catches all mail (UI at http://localhost:8025).
# Native WSL: set MAIL_MAILER=log and read links from storage/logs/laravel.log.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@school164.local"
MAIL_FROM_NAME="${APP_NAME}"

# Uploaded exam materials go to FILESYSTEM_DISK ("local" = storage/app/private).
# Production (ephemeral filesystem): set FILESYSTEM_DISK=s3 and fill in the AWS_* values below.
# Works with any S3-compatible service (AWS S3, Cloudflare R2, Backblaze B2, MinIO, DigitalOcean Spaces…).
# MATERIALS_DISK can override the disk for materials only (empty = FILESYSTEM_DISK).
MATERIALS_DISK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Endpoint for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com or http://minio:9000
AWS_ENDPOINT=
AWS_URL=
# true for MinIO and most self-hosted S3 servers
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Credentials for the admin account created by `php artisan db:seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
